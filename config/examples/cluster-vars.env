# Copy this file to config/cluster-vars.env and fill in your values.
# config/cluster-vars.env is gitignored (contains real network details).

# IMPORTANT: the cluster API is built as <CLUSTER_NAME>.<BASE_DOMAIN>, so
# BASE_DOMAIN must NOT already contain the cluster name. With the values
# below the API is api.ocp4-abi.example.com - these records must resolve
# on your network before the install can finish:
#   api.<CLUSTER_NAME>.<BASE_DOMAIN>        -> API_VIP
#   *.apps.<CLUSTER_NAME>.<BASE_DOMAIN>     -> INGRESS_VIP
CLUSTER_NAME="ocp4-abi"
BASE_DOMAIN="example.com"

# OpenShift release to install (the openshift-install binary must match)
OCP_VERSION="4.20.0"

# Networking. MACHINE_NETWORK_CIDR is the subnet the nodes live on the two VIPs must be free addresses inside it, not assigned to any node.
MACHINE_NETWORK_CIDR="192.0.2.0/24"
API_VIP="192.0.2.5"
INGRESS_VIP="192.0.2.6"

# Internal cluster networks - the defaults from the OpenShift docs. Only
# change these if they collide with something already routed on your network.
CLUSTER_NETWORK_CIDR="10.128.0.0/14"
CLUSTER_NETWORK_HOST_PREFIX="23"
SERVICE_NETWORK_CIDR="172.30.0.0/16"

# rendezvousIP: static IP of the node that coordinates the agent-based
RENDEZVOUS_IP="192.0.2.10"

# Paths (relative to repo root) to secrets NOT stored in git.
# Download the pull secret from console.redhat.com/openshift/install/pull-secret
PULL_SECRET_FILE="config/pull-secret.json"
SSH_PUBLIC_KEY_FILE="config/ssh-key.pub"

# Name of this cluster's directory under clusters/. Keeping one directory
# per cluster is what lets you install several clusters from the same
# checkout without overwriting each other's manifests, ISO or kubeconfig.
# Defaults to CLUSTER_NAME if left unset.
INSTALL_DIR="ocp4-abi"
