# Copy this file to config/vcenter-vars.env and fill in your values.
# config/vcenter-vars.env is gitignored on purpose: it is the only place
# where environment-specific vCenter connection details live.
#
# NOTE ON AUTH: no password is ever stored in this file or anywhere in the
# repo. scripts/install.sh and scripts/add-nodes.sh call vcenter_login()
# (defined in scripts/check-prereqs.sh), which prompts for the password of
# GOVC_USERNAME interactively and exchanges it for a session token via
# `govc session.login`. That token is cached under GOVC_HOME below (also
# gitignored) and reused until it expires, so the password is asked for
# once at most - and never written to disk.
# For unattended runs, export VCENTER_PASSWORD instead of being prompted.

# vCenter API endpoint 
export GOVC_URL="vcenter.example.local"

# Account used for the token exchange described above.
export GOVC_USERNAME="svc-openshift@vsphere.local"

# Skip TLS verification (true/false).
export GOVC_INSECURE="false"
# export GOVC_TLS_CA_CERTS="/path/to/ca.pem"

# vSphere inventory targets used to place/boot the cluster VMs.
# Each accepts either a bare name or a full inventory path, e.g.
#   GOVC_DATASTORE="datastore1"
#   GOVC_DATASTORE="/Datacenter1/datastore/DS Group/datastore1"
GOVC_DATACENTER="Datacenter1"
GOVC_CLUSTER="Cluster1"
GOVC_DATASTORE="datastore1"
GOVC_RESOURCE_POOL="Resources"
GOVC_NETWORK="VM Network"
GOVC_FOLDER="ocp4"

# Datastore used ONLY for uploading discovery/day-2 ISOs.
GOVC_ISO_DATASTORE="datastore-isos"

# Path (folder + filename) INSIDE GOVC_ISO_DATASTORE where the discovery ISO
# is uploaded. Must include the filename, not just a folder.
VCENTER_ISO_DATASTORE_PATH="ocp4-agent-iso/agent.x86_64.iso"

# Same, for day-2 "add nodes" ISOs (scripts/add-nodes.sh)
DAY2_ISO_DATASTORE_PATH="ocp4-agent-iso/day2/node.x86_64.iso"

# Directory where govc caches the session token obtained at login
GOVC_HOME=".govc"
